# Windows-only launchers. cmd.exe mis-parses multi-line if() blocks when the
# file has bare LF endings, so these are stored with CRLF and kept exactly as
# committed -- no normalisation on checkout, and none in the GitHub ZIP the
# README tells people to download.
*.cmd -text

# Left out of the ZIPs GitHub builds (a release's "Source code" and Code >
# Download ZIP), which are what reps download. Everything a rep runs stays:
# extension/, server/, scripts/, the .cmd launchers, README, LICENSE and
# docs/troubleshooting.md. A git clone still gets all of it.
tests/                export-ignore
docs/architecture.md  export-ignore
CLAUDE.md             export-ignore
.gitignore            export-ignore
.gitattributes        export-ignore
