{
  "manifest_version": 3,
  "name": "Salesloft Dialer Hotkeys",
  "version": "1.4",
  "description": "One-key cadence dialing with an optional floating control panel, live local call transcription, and a colour-coded alert when a contact is already tagged No Interest, Meeting Scheduled, or Interested.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["tabs", "storage", "scripting", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://app.salesloft.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "settings.html",
    "default_title": "Dialer Hotkeys settings",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.salesloft.com/*"],
      "js": ["defaults.js", "call-detect.js", "content.js", "alerts.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "kill-and-log": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "End call, log No Answer, complete step"
    },
    "start-call": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Start the next call"
    },
    "toggle-transcription": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Arm or stop live transcription (press with Salesloft in front)"
    }
  }
}
